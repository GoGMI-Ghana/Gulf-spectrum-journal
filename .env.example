# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# From your Supabase project settings (Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# From your Paystack dashboard (Settings -> API Keys & Webhooks). Server-only
# on purpose -- used by app/api/donations/initiate and app/api/paystack-webhook,
# never sent to the browser. Only the secret key is needed: donations use
# Paystack's hosted checkout (redirect flow), not the inline/popup widget,
# so there's no public key for client-side code to use.
PAYSTACK_SECRET_KEY=

# Server-only, from Supabase Studio -> Settings -> API Keys (the legacy
# service_role key, or the newer secret key). Bypasses RLS entirely -- used
# by app/api/account/delete and the Paystack webhook above.
SUPABASE_SERVICE_ROLE_KEY=

# Microsoft Graph app-only auth (Entra ID -> App registrations -> your app),
# used by app/api/auth/send-email-hook to actually deliver GoTrue's OTP/
# recovery/etc. emails via https://graph.microsoft.com/.../sendMail. The app
# registration needs the Mail.Send Application permission with admin consent
# granted, and MS_SENDER_EMAIL needs to be a real mailbox that app can send as.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=

# Shared with the self-hosted Auth service's GOTRUE_HOOK_SEND_EMAIL_SECRETS
# (that value is "v1,<this value>" -- the "v1," prefix is a Standard Webhooks
# versioning convention this app's webhook library doesn't expect on its own
# side). Verifies that a request to send-email-hook really came from GoTrue.
SEND_EMAIL_HOOK_SECRET=
